{
  // Type-checks the JavaScript with JSDoc annotations. Nothing is compiled: npm run typecheck.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/globals.d.ts", "src/**/*.mjs", "src/assets/app.js", "tests/**/*.mjs", "scripts/**/*.mjs"]
}
