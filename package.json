{
  "name": "nine-roads-out",
  "version": "1.0.0",
  "private": true,
  "description": "Nine Roads Out: the most beautiful day drives from Dublin. Static site, no runtime dependencies.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "preview": "node src/build.mjs --preview",
    "images": "node scripts/render-images.mjs",
    "serve": "npm run build && node scripts/serve.mjs dist",
    "audit": "node scripts/audit-pages.mjs",
    "check-links": "node scripts/check-links.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright": "^1.48.0"
  }
}
